# Fake examples only. Replace these with your Firebase project's web app config.
VITE_FIREBASE_API_KEY=YOUR_FIREBASE_WEB_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://your-project-id-default-rtdb.firebaseio.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000
VITE_FIREBASE_MEASUREMENT_ID=G-EXAMPLE0000

# Mock web-admin login for local Vite development only; not real authentication.
VITE_DEMO_ADMIN_EMAIL=demo-admin@example.invalid
VITE_DEMO_ADMIN_PASSWORD=replace-with-a-local-only-demo-password

# Optional shell variables for scripts/run-android-device.cjs.
# These are not loaded automatically from .env.local.
# ADB=adb
# EXPO_DEVICE_ID=YOUR_CONNECTED_DEVICE_SERIAL
# ANDROID_SDK_ROOT=YOUR_ANDROID_SDK_PATH
# ANDROID_HOME=YOUR_ANDROID_SDK_PATH
