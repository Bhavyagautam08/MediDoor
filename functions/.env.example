# Fake examples only. Replace with values from your PhonePe sandbox account.
PHONEPE_MERCHANT_ID=YOUR_PHONEPE_SANDBOX_MERCHANT_ID
PHONEPE_SALT_KEY=YOUR_PHONEPE_SANDBOX_SALT_KEY
PHONEPE_SALT_INDEX=1
PHONEPE_UAT_URL=https://api-preprod.phonepe.com/apis/pg-sandbox/pg/v1/pay

# Used only by functions/test.cjs, not the deployed payment function.
PHONEPE_TEST_MERCHANT_ID=YOUR_PHONEPE_TEST_MERCHANT_ID
PHONEPE_TEST_SALT_KEY=YOUR_PHONEPE_TEST_SALT_KEY
PHONEPE_TEST_SALT_INDEX=1
PHONEPE_TEST_UAT_URL=https://api-preprod.phonepe.com/apis/pg-sandbox/pg/v1/pay

# OTP sender credentials are read from Firestore settings/otp_config, not .env.
