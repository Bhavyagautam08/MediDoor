# Fake examples only. Replace these with your Firebase project's web app config.
EXPO_PUBLIC_FIREBASE_API_KEY=YOUR_FIREBASE_WEB_API_KEY
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
EXPO_PUBLIC_FIREBASE_DATABASE_URL=https://your-project-id-default-rtdb.firebaseio.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
EXPO_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=G-EXAMPLE0000

# Fake examples only. Replace with Google Maps keys restricted to this app and
# only the APIs it uses. EXPO_PUBLIC_* values are bundled into the client app.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=YOUR_RESTRICTED_GOOGLE_MAPS_API_KEY
EXPO_PUBLIC_GOOGLE_MAPS_PLACES_API_KEY=YOUR_RESTRICTED_GOOGLE_PLACES_API_KEY
