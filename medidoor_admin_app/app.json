{
  "expo": {
    "name": "MediDoor-Admin",
    "slug": "medidoor_admin_app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo.jpeg",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/logo.jpeg",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/logo.jpeg"
      },
      "package": "com.anonymous.medidoor_admin_app",
      "config": {
        "googleMaps": {
          "apiKey": "[REDACTED]"
        }
      }
    },
    "web": {
      "favicon": "./assets/logo.jpeg"
    },
    "plugins": [
      "expo-sharing"
    ]
  }
}
